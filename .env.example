# ─────────────────────────────────────────────
#  Wall Street CRM — namuna .env
#  Real qiymatlarni .env faylga ko'chiring
# ─────────────────────────────────────────────

SECRET_KEY="o'zingizning-maxfiy-kalitingiz"
DEBUG=True

# Gmail SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=siz@gmail.com
EMAIL_HOST_PASSWORD=app-parol-16-belgi
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=siz@gmail.com

# Google OAuth ("Google bilan kirish") — bepul hostda SMTP'siz ro'yxatdan o'tish.
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID.
# Authorized redirect URI: https://SIZNING-DOMEN/accounts/google/login/callback/
# Bo'sh qoldirilsa tugma ko'rinmaydi (lokalda shart emas).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── AI tahlillar ───────────────────────────────────────────
# Google Gemini (ASOSIY provayder) — bepul kalit: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Anthropic Claude (ixtiyoriy zaxira — GEMINI bo'lsa shart emas)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Telegram bot
TELEGRAM_BOT_TOKEN="123456:ABC..."
TECHNIC_BOT_TOKEN=
BOT_NAME="Wall Street CRM"
BOT_VERSION="3.0"
ADMIN_USERNAME="@vvall_street_admin"

# Media (rasm) saqlash — Render free disk efemeral (rasm yo'qoladi).
# USE_DB_MEDIA=True → rasmlar Postgres bazada saqlanadi (doimiy, chet el xizmati
# kerak emas, O'zbekistonda ishlaydi). Render'da DATABASE_URL bo'lsa avtomatik yoqiladi.
USE_DB_MEDIA=False
# CLOUDINARY_URL — ixtiyoriy muqobil (ba'zi davlatlarda bloklangan). Bo'sh = ishlatilmaydi.
CLOUDINARY_URL=

# Platforma manzili (bot tugmalari shu yerga olib o'tadi)
# Lokal:  http://127.0.0.1:8000
# Hostda: https://sizning-domeningiz.uz
WEBSITE_URL=http://127.0.0.1:8000

# Ijtimoiy tarmoqlar (ixtiyoriy)
SUPPORT_URL=https://t.me/vvall_street_admin
TELEGRAM_CHANNEL=https://t.me/wallstreet_lc
INSTAGRAM_URL=https://instagram.com/wallstreetcrm
YOUTUBE_URL=https://youtube.com/@wallstreetcrm
LINKEDIN_URL=https://linkedin.com/company/wallstreetcrm
